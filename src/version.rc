#include <winver.h>
#ifndef GI_VERSION_STR
#define GI_VERSION_STR "1.0.0"
#endif
#ifndef GI_VERSION_NUM
#define GI_VERSION_NUM 1,0,0,0
#endif
VS_VERSION_INFO VERSIONINFO
FILEVERSION GI_VERSION_NUM
PRODUCTVERSION GI_VERSION_NUM
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_DLL
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "FileDescription", "grail-input: keyboard and gamepad input mod for Grail (version.dll proxy)"
      VALUE "ProductName", "grail-input"
      VALUE "FileVersion", GI_VERSION_STR
      VALUE "ProductVersion", GI_VERSION_STR
      VALUE "OriginalFilename", "version.dll"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
